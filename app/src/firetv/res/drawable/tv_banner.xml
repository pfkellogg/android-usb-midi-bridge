<?xml version="1.0" encoding="utf-8"?>
<!-- Fire TV home banner (320x180): the Golden Gate badge on the dark app background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="320dp" android:height="180dp">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0E141A" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher"
        android:gravity="center" android:width="150dp" android:height="150dp" />
</layer-list>
